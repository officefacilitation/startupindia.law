{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "startup-india-law",
  "compatibility_date": "2024-09-23",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
